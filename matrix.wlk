object neo {
    var energia = 100
    

    method energia() {
        return energia
    }


    method neoSalta() { 
        return energia == energia / 2 
    }
    
    method vitalidadDeNeo() {
        return energia / 10 
    }

}


object morfeo {
    var vitalidadDeMorfeo = 8

    method vitalidadDeMorfeo() {
        return vitalidadDeMorfeo
    }

    
}




